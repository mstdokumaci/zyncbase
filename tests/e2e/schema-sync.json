{
	"version": "0.0.1",
	"store": {
		"tasks": {
			"fields": {
				"title": {
					"type": "string"
				},
				"must_be_complete": {
					"type": "object",
					"fields": {
						"before": {
							"type": "integer"
						},
						"after": {
							"type": "integer"
						}
					}
				},
				"tags": {
					"type": "array",
					"items": "string"
				}
			}
		},
		"unique_projects": {
			"required": ["slug", "provider", "externalId"],
			"fields": {
				"slug": { "type": "string" },
				"provider": { "type": "string" },
				"externalId": { "type": "string" },
				"profile": {
					"type": "object",
					"fields": {
						"handle": { "type": "string" }
					}
				}
			},
			"unique": [["slug"], ["provider", "externalId"], ["profile.handle"]]
		},
		"fk_parents": { "fields": {} },
		"fk_restrict_children": {
			"fields": {
				"parent_id": { "type": "string", "references": "fk_parents" }
			}
		},
		"fk_cascade_children": {
			"fields": {
				"parent_id": {
					"type": "string",
					"references": "fk_parents",
					"onDelete": "cascade"
				}
			}
		},
		"fk_nullable_children": {
			"fields": {
				"parent_id": {
					"type": "string",
					"references": "fk_parents",
					"onDelete": "set_null"
				}
			}
		}
	}
}
