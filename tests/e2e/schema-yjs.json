{
	"version": "0.0.1",
	"store": {
		"yjs_documents": {
			"unique": [["slug"]],
			"fields": {
				"slug": { "type": "string", "minLength": 1, "maxLength": 120 },
				"current_snapshot_id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"compacted_through": { "type": "integer", "minimum": 0 }
			}
		},
		"yjs_snapshots": {
			"required": ["document_id", "snapshot_id", "part", "parts"],
			"unique": [["snapshot_id", "part"]],
			"fields": {
				"document_id": {
					"type": "string",
					"references": "yjs_documents",
					"onDelete": "cascade",
					"indexed": true
				},
				"snapshot_id": { "type": "string", "minLength": 1, "maxLength": 64 },
				"part": { "type": "integer", "minimum": 0 },
				"parts": { "type": "integer", "minimum": 1 },
				"data": { "type": "bytes" }
			}
		},
		"yjs_updates": {
			"required": ["document_id", "update_id", "part", "parts"],
			"unique": [["update_id", "part"]],
			"fields": {
				"document_id": {
					"type": "string",
					"references": "yjs_documents",
					"onDelete": "cascade",
					"indexed": true
				},
				"update_id": { "type": "string", "minLength": 1, "maxLength": 64 },
				"part": { "type": "integer", "minimum": 0 },
				"parts": { "type": "integer", "minimum": 1 },
				"data": { "type": "bytes" }
			}
		},
		"notes": {
			"required": ["document_id"],
			"fields": {
				"document_id": {
					"type": "string",
					"references": "yjs_documents",
					"onDelete": "cascade",
					"indexed": true
				},
				"title": { "type": "string", "maxLength": 200 }
			}
		}
	}
}
