{
	"namespaces": [
		{
			"pattern": "world-1",
			"storeFilter": true,
			"presenceRead": true,
			"presenceWrite": false,
			"presenceSharedWrite": false
		}
	],
	"store": [
		{
			"collection": "meta",
			"read": { "$session.role": { "eq": "simulation" } },
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "country_chunks",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "user_chunks",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "users",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "countries",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		}
	],
	"actions": [
		{
			"action": "player_join",
			"invoke": { "$session.role": { "eq": "player" } },
			"register": { "$session.role": { "eq": "simulation" } }
		},
		{
			"action": "player_move",
			"invoke": { "$session.role": { "eq": "player" } },
			"register": { "$session.role": { "eq": "simulation" } }
		},
		{
			"action": "player_leave",
			"invoke": { "$session.role": { "eq": "player" } },
			"register": { "$session.role": { "eq": "simulation" } }
		},
		{
			"action": "*",
			"invoke": false,
			"register": false
		}
	]
}
