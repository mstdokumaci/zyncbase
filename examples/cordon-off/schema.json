{
	"version": "0.7.0",
	"store": {
		"users": {
			"namespaced": true,
			"fields": {
				"country_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"name": { "type": "string", "minLength": 1, "maxLength": 16 },
				"is_bot": { "type": "boolean" },
				"last_x": { "type": "integer", "minimum": 0 },
				"last_y": { "type": "integer", "minimum": 0 }
			}
		},
		"meta": {
			"required": ["next_country_id"],
			"fields": {
				"next_country_id": { "type": "integer", "minimum": 1 }
			}
		},
		"country_chunks": {
			"required": ["color_indexes"],
			"fields": {
				"color_indexes": { "type": "bytes", "minLength": 1, "maxLength": 2560 }
			}
		},
		"user_chunks": {
			"required": ["coordinates"],
			"fields": {
				"coordinates": { "type": "bytes", "maxLength": 131072 }
			}
		},
		"countries": {
			"required": ["country_id", "name", "color", "count"],
			"unique": [["country_id"], ["name"]],
			"fields": {
				"country_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"name": { "type": "string", "minLength": 1, "maxLength": 24 },
				"color": { "type": "string" },
				"count": { "type": "integer", "minimum": 0 },
				"is_bot": { "type": "boolean" }
			}
		}
	},
	"actions": {
		"player_join": {
			"params": {
				"name": { "type": "string", "minLength": 1, "maxLength": 16 },
				"country_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"session_id": { "type": "string", "minLength": 36, "maxLength": 36 }
			},
			"required": ["name", "country_id", "session_id"],
			"returns": { "user_id": { "type": "string" } }
		},
		"player_move": {
			"params": {
				"direction": {
					"type": "string",
					"enum": ["idle", "up", "down", "left", "right"]
				},
				"seq": { "type": "integer", "minimum": 0 }
			},
			"required": ["direction", "seq"],
			"returns": null
		},
		"player_leave": {
			"returns": null
		}
	}
}
