{
	"version": "0.2.0",
	"store": {
		"users": { "fields": {} },
		"meta": {
			"required": ["nextCode"],
			"fields": {
				"nextCode": { "type": "integer", "minimum": 1 }
			}
		},
		"chunks": {
			"required": ["owners", "dots"],
			"fields": {
				"owners": { "type": "bytes", "minLength": 2048, "maxLength": 2048 },
				"dots": { "type": "bytes", "maxLength": 16384 }
			}
		},
		"players": {
			"required": ["country_id", "is_bot", "lastX", "lastY"],
			"fields": {
				"country_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"name": { "type": "string", "minLength": 1, "maxLength": 16 },
				"is_bot": { "type": "boolean" },
				"lastX": { "type": "integer", "minimum": 0 },
				"lastY": { "type": "integer", "minimum": 0 }
			}
		},
		"countries": {
			"required": ["code", "name", "color", "count"],
			"unique": [["code"], ["name"]],
			"fields": {
				"code": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"name": { "type": "string", "minLength": 1, "maxLength": 24 },
				"color": { "type": "string" },
				"count": { "type": "integer", "minimum": 0 }
			}
		}
	},
	"presence": {
		"user": {
			"name": { "type": "string", "minLength": 1, "maxLength": 16 },
			"countryCode": { "type": "integer", "minimum": 1, "maximum": 65535 },
			"direction": {
				"type": "string",
				"enum": ["idle", "up", "down", "left", "right"]
			},
			"seq": { "type": "integer", "minimum": 0 },
			"sentAt": { "type": "number" },
			"pulse": { "type": "integer", "minimum": 0 }
		},
		"shared": {}
	}
}
