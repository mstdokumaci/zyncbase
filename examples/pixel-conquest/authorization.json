{
	"namespaces": [
		{
			"pattern": "pixel-conquest",
			"storeFilter": true,
			"presenceRead": true,
			"presenceWrite": { "$session.role": { "eq": "player" } },
			"presenceSharedWrite": false
		}
	],
	"store": [
		{
			"collection": "meta",
			"read": false,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "chunks",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "countries",
			"read": true,
			"write": { "$session.role": { "eq": "simulation" } }
		},
		{
			"collection": "users",
			"read": { "$doc.id": { "eq": "$session.userId" } },
			"write": false
		}
	]
}
