{
	"namespaces": [
		{
			"pattern": "verso:{workspace}",
			"storeFilter": { "$session.workspace": { "eq": "$namespace.workspace" } },
			"presenceRead": {
				"$session.workspace": { "eq": "$namespace.workspace" }
			},
			"presenceWrite": {
				"$session.workspace": { "eq": "$namespace.workspace" }
			},
			"presenceSharedWrite": false
		},
		{
			"pattern": "verso:{workspace}:doc:{page}",
			"storeFilter": { "$session.workspace": { "eq": "$namespace.workspace" } },
			"presenceRead": {
				"$session.workspace": { "eq": "$namespace.workspace" }
			},
			"presenceWrite": {
				"$session.workspace": { "eq": "$namespace.workspace" }
			},
			"presenceSharedWrite": false
		}
	],
	"store": [
		{
			"collection": "users",
			"read": true,
			"write": { "$doc.owner_id": { "eq": "$session.userId" } }
		},
		{ "collection": "pages", "read": true, "write": true },
		{ "collection": "page_changes", "read": true, "write": true },
		{ "collection": "page_snapshots", "read": true, "write": true }
	],
	"actions": []
}
